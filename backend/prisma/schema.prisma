generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AppointmentChannel {
  EMAIL
  WHATSAPP
  CHAT
  WEBSITE
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum GalleryOrientation {
  PORTRAIT
  LANDSCAPE
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  role         UserRole       @default(CLIENT)
  appointments Appointment[]
  suggestions  Suggestion[]
  votes        SuggestionVote[]
  conversations ChatConversation[]
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([role, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Appointment {
  id        String            @id @default(cuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName String
  contact   String
  service   String
  date      DateTime
  slot      String
  message   String            @default("")
  channel   AppointmentChannel @default(WEBSITE)
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date, status])
  @@index([userId, createdAt])
}

model Suggestion {
  id        String           @id @default(cuid())
  author    String
  content   String
  category  String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes     SuggestionVote[]
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

model SuggestionVote {
  id           String     @id @default(cuid())
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  voterKey     String
  createdAt    DateTime   @default(now())

  @@unique([suggestionId, voterKey])
  @@index([suggestionId])
}

model ShowroomProduct {
  id          String        @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String        @default("")
  stock       Int           @default(0)
  published   Boolean       @default(false)
  orders      ProductOrder[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, createdAt])
}

model GalleryAsset {
  id          String             @id @default(cuid())
  title       String
  description String             @default("")
  category    String             @default("Projet")
  mediaType   GalleryMediaType
  mediaPath   String
  orientation GalleryOrientation @default(LANDSCAPE)
  published   Boolean            @default(false)
  viewCount   Int                @default(0)
  orderCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([published, mediaType, createdAt])
}

model ProductOrder {
  id             String        @id @default(cuid())
  productId      String
  product        ShowroomProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  unitPrice      Int
  quantity       Int
  total          Int
  deliveryDays   Int
  customerName   String
  customerContact String
  message        String        @default("")
  status         OrderStatus   @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String?       @unique
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestKey  String?       @unique
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@index([guestKey, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  senderRole     String
  text           String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
